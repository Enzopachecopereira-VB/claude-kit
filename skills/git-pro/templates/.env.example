# Template de variáveis de ambiente.
# Copie para .env e preencha com valores reais (NÃO commite .env).
#
# Convenção: SCREAMING_SNAKE_CASE.
# Comentários explicam onde obter cada credencial.

# ─── Aplicação ─────────────────────────────────────────────────────────
NODE_ENV=development                    # development | production | test
PORT=3000
LOG_LEVEL=info                          # debug | info | warn | error

# ─── Banco de dados ────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/myapp_dev
# Em produção: usar secret manager (não env file)

# ─── APIs externas (exemplos) ──────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...           # https://console.anthropic.com/
# OPENAI_API_KEY=sk-...                  # https://platform.openai.com/
# STRIPE_SECRET_KEY=sk_test_...          # https://dashboard.stripe.com/
# GITHUB_TOKEN=ghp_...                   # https://github.com/settings/tokens

# ─── Auth / Sessão ─────────────────────────────────────────────────────
# JWT_SECRET=                            # gerar: openssl rand -base64 32
# SESSION_SECRET=                        # idem

# ─── Storage ───────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=

# ─── Cloudflare ────────────────────────────────────────────────────────
# CF_ACCOUNT_ID=
# CF_API_TOKEN=                          # https://dash.cloudflare.com/profile/api-tokens

# ─── Feature flags ─────────────────────────────────────────────────────
# FEATURE_X_ENABLED=false
